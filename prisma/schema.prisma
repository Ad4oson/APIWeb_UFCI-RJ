generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum StatusAluguel {
  ATIVO
  DEVOLVIDO
  ATRASADO
  CANCELADO
}

enum FormaPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  CANCELADO
  ESTORNADO
}

// ================= MODELS =================

model Usuario {
  id            Int      @id @default(autoincrement())
  nome          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  senha         String   @db.VarChar(255)
  telefone      String?  @db.VarChar(20)
  cpf           String?  @unique @db.VarChar(14)
  data_cadastro DateTime @default(now())
  ativo         Boolean  @default(true)
  role          String   @default("USER") @db.VarChar(20)

  alugueis   Aluguel[]
  avaliacoes Avaliacao[]

  @@map("usuario")
}

model Jogo {
  id                    Int     @id @default(autoincrement())
  nome                  String  @db.VarChar(150)
  descricao             String? @db.Text
  ano_lancamento        Int?    @db.Year
  numero_jogadores_min  Int
  numero_jogadores_max  Int
  idade_minima          Int
  duracao_minutos       Int
  quantidade_total      Int     @default(1)
  quantidade_disponivel Int     @default(1)
  valor_diaria          Decimal @db.Decimal(10, 2)
  ativo                 Boolean @default(true)
  complexidade          Int

  categorias CategoriaJogo[]
  alugueis   Aluguel[]
  avaliacoes Avaliacao[]

  @@index([nome], name: "idx_jogo_nome")
  @@map("jogo")
}

model Categoria {
  id    Int             @id @default(autoincrement())
  nome  String          @unique @db.VarChar(100)
  jogos CategoriaJogo[]

  @@index([nome], name: "idx_categoria_nome")
  @@map("categoria")
}

model CategoriaJogo {
  id_categoria Int
  id_jogo      Int

  categoria Categoria @relation(fields: [id_categoria], references: [id], onDelete: Cascade)
  jogo      Jogo      @relation(fields: [id_jogo], references: [id], onDelete: Cascade)

  @@id([id_categoria, id_jogo])
  @@map("categoria_jogo")
}

model Aluguel {
  id                      Int           @id @default(autoincrement())
  id_usuario              Int
  id_jogo                 Int
  data_aluguel            DateTime      @default(now())
  data_prevista_devolucao DateTime      @db.Date
  data_devolucao          DateTime?
  quantidade              Int           @default(1)
  valor_diaria            Decimal       @db.Decimal(10, 2)
  valor_total             Decimal?      @db.Decimal(10, 2)
  status                  StatusAluguel @default(ATIVO)
  local                   Boolean       @default(false)
  observacoes             String?       @db.Text

  usuario    Usuario     @relation(fields: [id_usuario], references: [id], onUpdate: Cascade, onDelete: Restrict)
  jogo       Jogo        @relation(fields: [id_jogo], references: [id], onUpdate: Cascade, onDelete: Restrict)
  pagamentos Pagamento[]

  @@index([id_usuario], name: "idx_aluguel_usuario")
  @@index([id_jogo], name: "idx_aluguel_jogo")
  @@index([status], name: "idx_aluguel_status")
  @@map("aluguel")
}

model Avaliacao {
  id             Int      @id @default(autoincrement())
  id_usuario     Int
  id_jogo        Int
  nota           Int
  comentario     String?  @db.Text
  data_avaliacao DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  jogo    Jogo    @relation(fields: [id_jogo], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_jogo], name: "uk_usuario_jogo")
  @@index([id_jogo], name: "idx_avaliacao_jogo")
  @@map("avaliacao")
}

model Pagamento {
  id              Int             @id @default(autoincrement())
  id_aluguel      Int
  valor           Decimal         @db.Decimal(10, 2)
  data_pagamento  DateTime        @default(now())
  forma_pagamento FormaPagamento?
  status          StatusPagamento @default(PENDENTE)

  aluguel Aluguel @relation(fields: [id_aluguel], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@map("pagamento")
}
